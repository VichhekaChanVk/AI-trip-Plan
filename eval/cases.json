{
  "inputCases": [
    {
      "id": "I01",
      "name": "Empty destination array",
      "payload": { "destinations": [], "durationDays": 3, "budget": "BALANCED" },
      "expectValid": false,
      "expectedErrorMatch": "Enter a destination"
    },
    {
      "id": "I02",
      "name": "Blank destination string",
      "payload": { "destinations": ["   "], "durationDays": 3, "budget": "BALANCED" },
      "expectValid": false,
      "expectedErrorMatch": "Enter a destination"
    },
    {
      "id": "I03",
      "name": "Duration zero days",
      "payload": { "destinations": ["Tokyo"], "durationDays": 0, "budget": "BALANCED" },
      "expectValid": false,
      "expectedErrorMatch": "durationDays"
    },
    {
      "id": "I04",
      "name": "Duration exceeds maximum 10 days",
      "payload": { "destinations": ["Tokyo"], "durationDays": 11, "budget": "BALANCED" },
      "expectValid": false,
      "expectedErrorMatch": "durationDays"
    },
    {
      "id": "I05",
      "name": "More cities than duration days (3 cities, 2 days)",
      "payload": { "destinations": ["Tokyo", "Kyoto", "Osaka"], "durationDays": 2, "budget": "BALANCED" },
      "expectValid": false,
      "expectedErrorMatch": "at least one day per city"
    },
    {
      "id": "I06",
      "name": "More than maximum 4 cities",
      "payload": { "destinations": ["Rome", "Florence", "Venice", "Milan", "Naples"], "durationDays": 5, "budget": "BALANCED" },
      "expectValid": false,
      "expectedErrorMatch": "At most 4 cities"
    },
    {
      "id": "I07",
      "name": "Invalid budget level",
      "payload": { "destinations": ["Paris"], "durationDays": 3, "budget": "SUPER_CHEAP" },
      "expectValid": false,
      "expectedErrorMatch": "budget"
    },
    {
      "id": "I08",
      "name": "Risky script characters in inspiration cleaned",
      "payload": { "destinations": ["Tokyo"], "durationDays": 2, "budget": "BALANCED", "inspiration": "<script>alert('hack')</script> {payload}" },
      "expectValid": true,
      "cleanCheck": true
    },
    {
      "id": "I09",
      "name": "Normal valid payload",
      "payload": { "destinations": ["Tokyo"], "durationDays": 3, "budget": "SAVER", "vibeTags": ["Foodie"] },
      "expectValid": true
    }
  ],
  "generateCases": [
