# Copy this file to .env and fill in your values. Never commit .env or share real keys.
# Every variable is read on the server only (none use the NEXT_PUBLIC_ prefix),
# so keys are never sent to the browser.

# --- Database ---------------------------------------------------------------
# SQLite file, created by `npm run db:push`. The path is relative to prisma/schema.prisma.
# For production, switch the Prisma provider to "postgresql" and use a Postgres URL.
DATABASE_URL="file:./dev.db"

# --- AI provider (any OpenAI-compatible API, via the Vercel AI SDK) ----------
# Option A (default): DeepSeek.
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"
DEEPSEEK_MODEL="deepseek-chat"

# Option B: OpenAI. The DEEPSEEK_* values win when set, so to use OpenAI,
# delete or comment out ALL three DEEPSEEK_* lines above, then uncomment these.
# OPENAI_API_KEY=""
# OPENAI_BASE_URL="https://api.openai.com/v1"
# OPENAI_MODEL="gpt-4o-mini"

# --- Keyless services (nothing to configure) -------------------------------
# Weather + geocoding: Open-Meteo. Map tiles: OpenStreetMap.
# Place photos: Wikipedia / Wikimedia. Booking links: Booking.com, Google Flights.
