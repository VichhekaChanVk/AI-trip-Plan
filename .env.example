# Database (SQLite file, created by `npm run db:push`)
DATABASE_URL="file:./dev.db"

# AI provider (any OpenAI-compatible API). DeepSeek is the default.
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"
DEEPSEEK_MODEL="deepseek-chat"

# Alternative: use OpenAI instead (leave the DeepSeek key empty)
# OPENAI_API_KEY=""
# OPENAI_BASE_URL="https://api.openai.com/v1"
# OPENAI_MODEL="gpt-4o-mini"

# Weather, geocoding and maps are keyless (Open-Meteo + OpenStreetMap).
