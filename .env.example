# SQLite file database (created by `npm run db:push`). Swap the Prisma provider to
# "postgresql" and use a Supabase/Postgres URL for production.
DATABASE_URL="file:./dev.db"

# AI (Vercel AI SDK + OpenAI structured output)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Weather, geocoding and the map are keyless (Open-Meteo + OpenStreetMap).
