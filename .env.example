# SQLite file database (created by `npm run db:push`). Swap the Prisma provider to
# "postgresql" and use a Postgres URL for production.
DATABASE_URL="file:./dev.db"

# AI (Vercel AI SDK structured output). The code uses DEEPSEEK_* first, then OPENAI_*.
# Note: if only OPENAI_API_KEY is set the base URL still defaults to DeepSeek unless
# you also set OPENAI_BASE_URL (e.g. https://api.openai.com/v1).
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-chat"
# OPENAI_API_KEY=""
# OPENAI_BASE_URL="https://api.openai.com/v1"
# OPENAI_MODEL="gpt-4o-mini"

# Weather, geocoding and the map are keyless (Open-Meteo + OpenStreetMap).
