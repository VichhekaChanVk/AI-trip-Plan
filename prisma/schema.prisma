generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Trip {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  destination    String
  durationDays   Int      @map("duration_days")
  budget         String   // SAVER | BALANCED | LUXURY
  vibeTags       String   @default("[]") @map("vibe_tags") // JSON stringified array of tags
  weatherSummary String?  @map("weather_summary")
  startDate      DateTime @map("start_date")
  centerLat      Float    @map("center_lat")
  centerLng      Float    @map("center_lng")
  summary        String?
  createdAt      DateTime @default(now()) @map("created_at")
  // JSON: [{ name, label, lat, lng }] - one entry per city, in visiting order
  destinations   String   @default("[]")
  // JSON string arrays / flags chosen on the form
  needs          String   @default("[]")
  hiddenGems     Boolean  @default(false) @map("hidden_gems")
  inspiration    String?
  // JSON: PackingList (generated on demand)
  packingList    String?  @map("packing_list")

  items ItineraryItem[]

  @@index([userId, createdAt])
  @@map("trips")
}

model ItineraryItem {
  id             String @id @default(cuid())
  tripId         String @map("trip_id")
  dayNumber      Int    @map("day_number")
  sortOrder      Int    @map("sort_order")
  title          String
  description    String
  timeBadge      String @map("time_badge") // "09:30"
  lat            Float
  lng            Float
  categoryTag    String @map("category_tag")
  costInfo       String @map("cost_info")   // human readable, e.g. "$25"
  estimatedCost  Float  @default(0) @map("estimated_cost")
  estimatedHours Float  @default(1) @map("estimated_hours")
  transitNote    String? @map("transit_note")
  transitCost    Float  @default(0) @map("transit_cost") // USD pp to get here from previous stop
  indoor         Boolean @default(false)                  // mostly sheltered (used by weather-aware planning)
  city           String?                                  // which city of a multi-city trip

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, dayNumber, sortOrder])
  @@map("itinerary_items")
}
